# Ignore node_modules (never commit these!)
node_modules/

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment variables and secrets
.env
.env.local
.env.*.local

# Ignore build output (if using TypeScript or Babel, etc)
dist/
build/
lib/

# Ignore Firebase local emulators data
firebase-debug.log
.firebaserc

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE/project files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore test files
mobile-touch-test.html
index-fixed.html
test-mobile-calendar.html

# Ignore assets directory if using CDN fallbacks
assets/

# Ignore demo screenshots
logo-enhanced-*.png