# ============================================
# Firebase Functions Gen2 Environment Variables
# ============================================
# Copy this file to .env and fill in the actual values
# See docs/CONFIGURATION.md for complete documentation

# ============================================
# ⚠️ IMPORTANT: RECAPTCHA_SECRET - MUST be set via Secret Manager!
# ============================================
# DO NOT set RECAPTCHA_SECRET here as a plain environment variable.
# It must be configured using Firebase Secret Manager to avoid deployment conflicts.
#
# To set the secret:
#   firebase functions:secrets:set RECAPTCHA_SECRET
#
# Get your reCAPTCHA v3 secret key from:
#   https://www.google.com/recaptcha/admin
#
# See: docs/SECRET_MANAGER.md for detailed instructions
# ============================================

# ============================================
# EMAIL CONFIGURATION (Required for booking confirmations)
# ============================================
# --- Primary email provider: SendGrid HTTP API ---
# Using the SendGrid API avoids SMTP relay throttling (421 errors).
# Obtain a free API key at https://sendgrid.com (free tier: 100 emails/day)
#
# ⚠️ SECURITY: Store this in Secret Manager for production:
#   firebase functions:secrets:set SENDGRID_API_KEY
#
# Format: SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# --- Fallback email provider: Gmail SMTP (STARTTLS port 587) ---
# Used when SENDGRID_API_KEY is not set.
# Gmail account used for sending booking confirmation emails
# Format: your-email@gmail.com
EMAIL_USER=Palvelut@fixnero.fi

# Gmail App Password (NOT your regular Gmail password)
# ⚠️ SECURITY WARNING: The example below is a placeholder only!
# ⚠️ NEVER use example passwords - always generate a unique App Password
# ⚠️ RECOMMENDED: Store this in Secret Manager for production:
#   firebase functions:secrets:set EMAIL_PASSWORD
#
# How to generate App Password:
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Enable 2-Step Verification if not already enabled
#   3. Select app: "Mail", device: "Other (Custom name)"
#   4. Name it "Rajala Booking System"
#   5. Generate and copy the 16-character password (no spaces)
#   6. Use your UNIQUE generated password below
#
# Format: 16 lowercase letters
# Example (DO NOT USE): abcdefghijklmnop
EMAIL_PASSWORD=your-16-char-app-password

# Display name and email address for outgoing emails
# This appears as "From" in customer emails
# Format: Display Name <email@domain.com>
EMAIL_FROM=Fixnero <Palvelut@fixnero.fi>

# ============================================
# GOOGLE CALENDAR CONFIGURATION (Required for calendar sync)
# ============================================
# Google Service Account JSON (stringified and minified)
# ⚠️ RECOMMENDED: Store this in Secret Manager for production
#
# How to get Service Account JSON:
#   1. Go to https://console.cloud.google.com
#   2. Select project: Webbi1
#   3. IAM & Admin > Service Accounts
#   4. Create or select service account
#   5. Keys > Add Key > Create new key > JSON
#   6. Download JSON file
#   7. Minify: cat service-account.json | jq -c '.'
#   8. Paste minified JSON as single line below
#
# Format: Must be valid JSON on a single line
# Example: {"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Google Calendar ID for booking synchronization
# This should be the calendar ID for Palvelut@fixnero.fi
# How to find Calendar ID:
#   1. Go to https://calendar.google.com
#   2. Log in as Palvelut@fixnero.fi
#   3. Settings > Settings for my calendars
#   4. Select your booking calendar
#   5. Scroll to "Integrate calendar"
#   6. Copy "Calendar ID"
#
# Format: xxxxxxx@group.calendar.google.com or email@domain.com
# Example: c_1234567890abcdef@group.calendar.google.com or Palvelut@fixnero.fi
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Calendar webhook callback URL (for push notifications from Google Calendar)
# This MUST point to the calendarWebhook Cloud Function in your current Firebase project.
#
# ⚠️ IMPORTANT after a domain/project migration:
#   If the Google Calendar → website sync stopped working after a domain change,
#   the watch channel is likely expired or registered with an old URL. You must:
#   1. (Optional) Set WATCH_CALLBACK_URL to the correct project URL below.
#   2. POST to watchRegistrar ONCE to register a fresh watch channel.
#      If WATCH_CALLBACK_URL is not set, the URL is auto-detected from GCLOUD_PROJECT env.
#   3. The scheduleWatchRenewal Cloud Function will auto-renew every 5 days.
#   You can check current watch status at: GET /watchStatus
#
# Format: https://REGION-PROJECT_ID.cloudfunctions.net/calendarWebhook
# webbi1 project: https://europe-north1-webbi1.cloudfunctions.net/calendarWebhook
#
# If left unset, the URL is auto-derived from the GCLOUD_PROJECT environment variable.
WATCH_CALLBACK_URL=https://europe-north1-webbi1.cloudfunctions.net/calendarWebhook

# ============================================
# FIREBASE CONFIGURATION (Optional - auto-detected)
# ============================================
# Firebase project ID (usually auto-detected from .firebaserc)
# Only set this if you need to override the default
# FIREBASE_PROJECT_ID=Webbi1

# Firebase region for Cloud Functions
# Default: europe-north1
# FIREBASE_REGION=europe-north1

# ============================================
# CORS CONFIGURATION (Optional)
# ============================================
# Allowed origins for CORS (comma-separated)
# Default includes fixnero.fi and common variants
# ALLOWED_ORIGINS=https://fixnero.fi,https://www.fixnero.fi

# ============================================
# BUSINESS CONFIGURATION (Optional)
# ============================================
# Business timezone for calendar events
# Default: Europe/Helsinki
# TIMEZONE=Europe/Helsinki

# Business hours (24-hour format HH:MM)
# BUSINESS_HOURS_START=09:00
# BUSINESS_HOURS_END=17:00

# Business days (0=Sunday, 1=Monday, ..., 6=Saturday)
# Default: 1,2,3,4,5 (Monday to Friday)
# BUSINESS_DAYS=1,2,3,4,5

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable/disable specific features (true/false)
# ENABLE_EMAIL=true
# ENABLE_CALENDAR_SYNC=true
# ENABLE_RECAPTCHA=true

# Debug mode (enables verbose logging)
# ⚠️ WARNING: Never enable in production!
# DEBUG_MODE=false

# ============================================
# NOTES AND BEST PRACTICES
# ============================================
#
# Security:
#   - NEVER commit this file with real values to Git
#   - Use Secret Manager for sensitive values in production
#   - Rotate credentials regularly (quarterly recommended)
#
# Environment Separation:
#   - Use different .env files for dev/staging/production
#   - Test thoroughly before production deployment
#
# Validation:
#   - Run validation before deployment (if script available)
#   - Verify all required variables are set
#
# Documentation:
#   - See docs/CONFIGURATION.md for complete guide
#   - See docs/SECRET_MANAGER.md for secret management
#   - See docs/MIGRATION_GUIDE.md for setup instructions
#
# ============================================
